<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBackNotificationSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="@color/admin_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/notification_settings"
            android:textColor="@color/admin_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section A: Push Notifications Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_soft_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/admin_primary_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Push Notifications"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Receive important updates on your device."
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/admin_border" />

                    <!-- Push Option 1 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swPushSystemAnnouncements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/system_announcements_nimportant_system_not"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Push Option 2 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swPushNewUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="New User Registration\nNotify when new users register"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Push Option 3 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swPushCourseUpdates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="Course Updates\nNotify about course changes"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Push Option 4 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swPushReportGen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="Report Generation\nNotify when reports are ready"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section B: Email Notifications Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_soft_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/admin_primary_blue" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/email_notifications"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Receive notifications via email."
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/admin_border" />

                    <!-- Email Option 1 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swEmailSystemAnnounce"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/system_announcements_nimportant_announceme"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Email Option 2 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swEmailWeeklyReports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/weekly_reports_nreceive_weekly_summary_rep"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Email Option 3 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swEmailSecurityAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="@string/security_alerts_nimportant_security_notifi"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Email Option 4 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swEmailNewUser"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="false"
                        android:text="New User Registration\nEmail when new users register"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Email Option 5 -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swEmailCourseUpdates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="Course Updates\nNotifications about course changes"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13sp"
                        app:useMaterialThemeColors="true" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section C: Quiet Hours Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swQuietHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quiet Hours\nDisable notifications during specific hours"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="14sp"
                        app:useMaterialThemeColors="true" />

                    <!-- Quiet Hours Time Container -->
                    <LinearLayout
                        android:id="@+id/containerQuietHoursTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/start_time"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvQuietHoursStart"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:text="10:00 PM"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="End Time"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvQuietHoursEnd"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:text="07:00 AM"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelNotifSettings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/admin_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/admin_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNotifSettings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/admin_primary_blue"
            android:text="@string/save_changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
