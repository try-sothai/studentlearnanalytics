<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_social_button"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Learning Report"
                android:textColor="@color/brand_deep_navy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/export_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Semester 1, 2024"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_graduation_cap"
                    android:contentDescription="Graduation Logo"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:text="Student Learning Report"
                    android:textColor="@color/brand_deep_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Semester 1, 2024"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:columnCount="2">

                    <TextView android:text="Student Name:" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tvReportStudentName" android:text="Sophea" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp" />

                    <TextView android:text="Student ID:" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    <TextView android:id="@+id/tvReportStudentId" android:text="STU023001" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginTop="8dp" />

                    <TextView android:text="Department:" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="8dp"/>
                    <TextView android:id="@+id/tvReportDepartment" android:text="Computer Science" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginTop="8dp" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Performance Summary"
                    android:textColor="@color/brand_deep_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:stretchColumns="0">

                    <TableRow android:layout_marginTop="8dp">
                        <TextView android:text="Attendance" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvReportAttendance" android:text="88%" android:layout_marginStart="16dp" android:textStyle="bold" android:textColor="@color/brand_deep_navy" />
                    </TableRow>

                    <TableRow android:layout_marginTop="8dp">
                        <TextView android:text="Assignment" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvReportAssignment" android:text="80%" android:layout_marginStart="16dp" android:textStyle="bold" android:textColor="@color/brand_deep_navy" />
                    </TableRow>

                    <TableRow android:layout_marginTop="8dp">
                        <TextView android:text="Quiz" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvReportQuiz" android:text="78%" android:layout_marginStart="16dp" android:textStyle="bold" android:textColor="@color/brand_deep_navy" />
                    </TableRow>

                    <TableRow android:layout_marginTop="8dp">
                        <TextView android:text="GPA" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvReportGpa" android:text="3.25" android:layout_marginStart="16dp" android:textStyle="bold" android:textColor="@color/brand_deep_navy" />
                    </TableRow>

                    <TableRow android:layout_marginTop="8dp">
                        <TextView android:text="Predicted Exam Score" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvReportPredictedScore" android:text="76.5" android:layout_marginStart="16dp" android:textStyle="bold" android:textColor="@color/brand_deep_navy" />
                    </TableRow>

                    <TableRow android:layout_marginTop="8dp">
                        <TextView android:text="Risk Level" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/tvReportRiskLevel" android:text="MEDIUM" android:layout_marginStart="16dp" android:textStyle="bold" android:textColor="@color/warning_orange" />
                    </TableRow>
                </TableLayout>

                <Button
                    android:id="@+id/btnDownloadPdf"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_button_primary_v2"
                    android:text="Download PDF"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
