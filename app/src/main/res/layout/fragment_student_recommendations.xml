<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teacher_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <include
        android:id="@+id/headerStudentRecommendations"
        layout="@layout/layout_student_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Summary Metrics Cards Grid (2x2) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/admin_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Academic Support &amp; AI Recommendations Summary"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="6dp"
                        android:background="@color/admin_border" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="8dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/active_suggestions" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvRecActiveCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_0_active" android:textColor="@color/admin_primary_blue" android:textSize="14.5sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="8dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High Priority" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvRecHighPriorityCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Urgent" android:textColor="@color/admin_inactive_red" android:textSize="14.5sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/total_recommendations" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvRecTotalCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_0_total" android:textColor="@color/admin_active_green" android:textSize="14.5sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Completed Plans" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvRecCompletedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_0_done" android:textColor="@color/admin_purple_accent" android:textSize="14.5sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="@color/admin_primary_blue"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search" app:startIconTint="@color/admin_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtSearchStudentRecommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/search_recommendations_by_title_or_course"
                    android:inputType="text" android:textColor="@color/admin_text_primary" android:textSize="12.5sp"
                        android:minHeight="44dp"
                        android:paddingVertical="10dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:imeOptions="actionSearch"
                        android:textColorHint="@color/admin_text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Personalized AI Study Recommendations" android:textColor="@color/admin_text_primary" android:textSize="13.5sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvEmptyRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="12dp"
                android:text="No recommendations available yet."
                android:textColor="@color/admin_text_secondary"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <!-- Recommendations Roster -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStudentRecommendationsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
