<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvGroupLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:textColor="@color/slas_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGroupRaw"
            android:layout_width="86dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/slas_text_secondary"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tvGroupWeighted"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/slas_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGroupComponents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:textColor="@color/slas_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <View
        android:id="@+id/viewGroupDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

</LinearLayout>
