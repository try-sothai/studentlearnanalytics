<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/student_drawer_view"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/bg_admin_drawer"
    android:clickable="true"
    android:elevation="16dp"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Compact Profile Header -->
    <include
        android:id="@+id/headerStudentDrawer"
        layout="@layout/nav_header_student" />

    <!-- Scrollable Navigation Items -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <!-- "Main Menu" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/main_menu"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 0. Home -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconHome"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_home"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_home"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/student_dashboard_and_academic_overview"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronHome"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 1. My Courses -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconCourses"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_book"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleCourses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_courses"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleCourses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/view_enrolled_courses_and_course_progress"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronCourses"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 2. Learning Analytics -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconAnalytics"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_analytics"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleAnalytics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/learning_analytics"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleAnalytics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/track_academic_performance_and_learning_pr"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronAnalytics"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 3. Prediction & Risk -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerPrediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconPrediction"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_prediction"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitlePrediction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prediction_risk"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitlePrediction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/view_predicted_scores_and_academic_risk"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronPrediction"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 4. Recommendations -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconRecommendations"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_circle_info"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleRecommendations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recommendations"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleRecommendations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Personalized academic recommendations"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronRecommendations"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 5. Assessments -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerAssessments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconAssessments"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_assignment"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleAssessments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/assessments"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleAssessments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/assignments_homework_quizzes_and_exams"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronAssessments"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="6dp"
                android:background="@color/drawer_divider" />

            <!-- "Account" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/account"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 6. Notifications -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconNotifications"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_notifications"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/academic_notifications_and_announcements"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronNotifications"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 7. Reports -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconReports"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_nav_reports"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleReports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_reports"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleReports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Academic reports and performance summaries"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronReports"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 8. Profile -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconProfile"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_profile"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/manage_personal_and_academic_information"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronProfile"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 9. Settings -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconSettings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_settings"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Account and application preferences"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronSettings"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="6dp"
                android:background="@color/drawer_divider" />

            <!-- "Other" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/other"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- 10. Help & Support -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconHelp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_circle_info"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/help_support"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Help center and student support"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronHelp"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 11. About -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconAbout"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/menu_icon"
                    android:src="@drawable/ic_info"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Application information and version"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronAbout"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Logout Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/itemStudentDrawerLogout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_admin_drawer_logout"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/log_out_icon"
                android:src="@drawable/ic_nav_logout"
                app:tint="@color/drawer_logout_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/log_out"
                android:textColor="@color/drawer_logout_red"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
