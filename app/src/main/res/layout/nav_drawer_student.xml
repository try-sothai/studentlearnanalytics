<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/student_drawer_view"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/bg_admin_drawer"
    android:clickable="true"
    android:elevation="16dp"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Compact Profile Header -->
    <include
        android:id="@+id/headerStudentDrawer"
        layout="@layout/nav_header_student" />

    <!-- Scrollable Navigation Items -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- "Main Menu" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"
                android:text="Main Menu"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 0. Home -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_home"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Student dashboard and academic overview"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronHome"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 1. My Courses -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerCourses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconCourses"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_book"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleCourses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Courses"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleCourses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="View enrolled courses and course progress"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronCourses"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 2. Learning Analytics -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconAnalytics"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_analytics"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleAnalytics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Learning Analytics"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleAnalytics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Track academic performance and learning progress"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronAnalytics"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 3. Prediction & Risk -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerPrediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconPrediction"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_prediction"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitlePrediction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prediction &amp; Risk"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitlePrediction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="View predicted scores and academic risk"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronPrediction"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 4. Recommendations -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconRecommendations"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_circle_info"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleRecommendations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recommendations"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleRecommendations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Personalized academic recommendations"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronRecommendations"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 5. Assessments -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerAssessments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconAssessments"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_assignment"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleAssessments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assessments"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleAssessments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Assignments, homework, quizzes and exams"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronAssessments"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="10dp"
                android:background="@color/drawer_divider" />

            <!-- "Account" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"
                android:text="Account"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 6. Notifications -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconNotifications"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Academic notifications and announcements"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronNotifications"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 7. Reports -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconReports"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_nav_reports"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleReports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reports"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleReports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Academic reports and performance summaries"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronReports"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 8. Profile -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconProfile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Manage personal and academic information"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronProfile"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- 9. Settings -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Account and application preferences"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronSettings"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="10dp"
                android:background="@color/drawer_divider" />

            <!-- "Other" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"
                android:text="Other"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 10. Help & Support -->
            <LinearLayout
                android:id="@+id/itemStudentDrawerHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconHelp"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_circle_info"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
