            <LinearLayout
                android:id="@+id/itemStudentDrawerAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/imgDrawerItemIconAbout"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Menu Icon"
                    android:src="@drawable/ic_info"
                    app:tint="@color/drawer_primary_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerItemTitleAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerItemSubtitleAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Application information and version"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerItemChevronAbout"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Chevron Right"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/drawer_primary_blue" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Logout Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/itemStudentDrawerLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_admin_drawer_logout"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Log Out Icon"
                android:src="@drawable/ic_nav_logout"
                app:tint="@color/drawer_logout_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Log Out"
                android:textColor="@color/drawer_logout_red"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>