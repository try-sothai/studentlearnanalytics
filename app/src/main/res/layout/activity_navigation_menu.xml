<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_navigation_gradient"
    android:fitsSystemWindows="true"
    tools:context=".student.NavigationMenuActivity">

    <!-- Ambient background glow top right -->
    <ImageView
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_ambient_circle_top"
        android:contentDescription="Ambient glow"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ambient background glow bottom right -->
    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_ambient_circle_bottom"
        android:contentDescription="Ambient glow"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Close 'X' Button Top Right -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/close_menu"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_close_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Profile Header Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfileAvatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="36dp"
        app:cardElevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="2.5dp">

        <ImageView
            android:id="@+id/imgUserProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/user_profile_picture"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_student_avatar" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutProfileInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/cardProfileAvatar"
        app:layout_constraintEnd_toStartOf="@id/btnClose"
        app:layout_constraintStart_toEndOf="@id/cardProfileAvatar"
        app:layout_constraintTop_toTopOf="@id/cardProfileAvatar">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sophea"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStudentId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="STU023001"
            android:textColor="#D0D6FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvMajor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/computer_science"
            android:textColor="#D0D6FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/str_3rd_year"
            android:textColor="#D0D6FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Scrollable Vertical Navigation Menu -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutFooter"
        app:layout_constraintTop_toBottomOf="@id/cardProfileAvatar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <!-- 1. Home -->
            <LinearLayout
                android:id="@+id/menu_home"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/home_icon"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/tv_menu_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/nav_home"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 2. Courses -->
            <LinearLayout
                android:id="@+id/menu_courses"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/courses_icon"
                    android:src="@drawable/ic_book" />

                <TextView
                    android:id="@+id/tv_menu_courses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/nav_courses"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 3. Learning Analytics -->
            <LinearLayout
                android:id="@+id/menu_analytics"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/learning_analytics_icon"
                    android:src="@drawable/ic_nav_analytics" />

                <TextView
                    android:id="@+id/tv_menu_analytics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/learning_analytics"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 4. Prediction & Risk -->
            <LinearLayout
                android:id="@+id/menu_prediction"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/prediction_risk_icon"
                    android:src="@drawable/ic_nav_prediction" />

                <TextView
                    android:id="@+id/tv_menu_prediction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/prediction_risk"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 5. Recommendations -->
            <LinearLayout
                android:id="@+id/menu_recommendation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/recommendations_icon"
                    android:src="@drawable/ic_nav_recommendation" />

                <TextView
                    android:id="@+id/tv_menu_recommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/recommendations"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 5.5. Assessments (NEW) -->
            <LinearLayout
                android:id="@+id/menu_assessments"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/assessments_icon"
                    android:src="@drawable/ic_assignment" />

                <TextView
                    android:id="@+id/tv_menu_assessments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/assessments"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 6. Notifications (with Red Badge "3") -->
            <LinearLayout
                android:id="@+id/menu_notifications"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/notifications_icon"
                    android:src="@drawable/ic_nav_notifications" />

                <TextView
                    android:id="@+id/tv_menu_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/nav_notifications"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvNotifBadge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_nav_badge_red"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 7. Reports -->
            <LinearLayout
                android:id="@+id/menu_reports"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/reports_icon"
                    android:src="@drawable/ic_nav_reports" />

                <TextView
                    android:id="@+id/tv_menu_reports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/nav_reports"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 8. Profile -->
            <LinearLayout
                android:id="@+id/menu_profile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/profile_icon"
                    android:src="@drawable/ic_nav_profile" />

                <TextView
                    android:id="@+id/tv_menu_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/nav_profile"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 9. Settings -->
            <LinearLayout
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/settings_icon"
                    android:src="@drawable/ic_nav_settings" />

                <TextView
                    android:id="@+id/tv_menu_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/nav_settings"
                    android:textColor="#EFEFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- 10. Logout -->
            <LinearLayout
                android:id="@+id/menu_logout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginVertical="2dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/logout_icon"
                    android:src="@drawable/ic_nav_logout" />

                <TextView
                    android:id="@+id/tv_menu_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:text="@string/logout"
                    android:textColor="#FF5252"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer Section Center Bottom -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Graduation Cap"
            android:src="@drawable/ic_nav_graduation_cap" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="&quot;Learn Today, Achieve Tomorrow&quot;"
            android:textColor="#C0C8FF"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
