<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/slas_surface"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvBreakdownCourseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/score_breakdown"
        android:textColor="@color/slas_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBreakdownCourseSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/slas_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/slas_border" />

    <ProgressBar
        android:id="@+id/pbBreakdownLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutBreakdownTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Table Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="8dp"
                android:text="@string/assessment_group"
                android:textColor="@color/slas_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/raw_score"
                android:textColor="@color/slas_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="78dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/weighted"
                android:textColor="@color/slas_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Weighted Groups -->
        <LinearLayout
            android:id="@+id/llBreakdownRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/slas_border" />

        <!-- Total Score & Final Grade -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total_score"
                android:textColor="@color/slas_text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBreakdownTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:textColor="@color/slas_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBreakdownGrade"
                style="@style/SlasStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_slas_pill_neutral"
                android:text="N/A"
                android:textColor="@color/slas_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBreakdownError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:textColor="@color/slas_danger"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseBreakdown"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="@string/close"
            android:textAllCaps="false"
            android:textColor="@color/slas_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFullCourseGrade"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/slas_surface"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/view_assessments"
            android:textAllCaps="false"
            android:textColor="@color/slas_primary_purple"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:elevation="0dp"
            app:strokeColor="@color/slas_primary_purple"
            app:strokeWidth="1dp" />
    </LinearLayout>

</LinearLayout>
