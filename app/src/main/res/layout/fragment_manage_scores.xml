<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teacher_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <include
        android:id="@+id/headerTeacherScoreManagement"
        layout="@layout/layout_teacher_header" />

    <!-- Sub-Navigation Bar (6 Internal Tabs) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_notif_tab_inactive"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/tabScoreOverview"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_notif_tab_active"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Overview"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabScorePending"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Pending Scores"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabScoreAssignments"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Assignments"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabScoreQuizzes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Quizzes"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabScoreExams"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Exams"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabScoreGradebook"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Gradebook"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Frame -->
    <FrameLayout
        android:id="@+id/layoutScoreContentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SUB-TAB 0: SCORE MANAGEMENT OVERVIEW (Default View) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secScoreOverviewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Summary Cards Grid (2x2) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Score Management Overview"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/admin_border" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:rowCount="2">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Assessments" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24 Active" android:textColor="@color/admin_primary_blue" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending Scores" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8 Needing Grading" android:textColor="@color/warning_orange" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Completed Graded" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16 Graded" android:textColor="@color/admin_active_green" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Average Class Score" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="84.2%" android:textColor="@color/admin_purple_accent" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Score Submission Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Score Submission &amp; Grading Progress"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/admin_border" />

                        <!-- Course 1 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CS101 — Intro to Computer Science" android:textColor="@color/admin_text_primary" android:textSize="13sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="85% Graded" android:textColor="@color/admin_primary_blue" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="4dp" android:max="100" android:progress="85" android:progressTint="@color/admin_primary_blue"/>
                        </LinearLayout>

                        <!-- Course 2 -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="IT402 — Web Development Systems" android:textColor="@color/admin_text_primary" android:textSize="13sp" android:textStyle="bold"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="70% Graded" android:textColor="@color/warning_orange" android:textSize="13sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="4dp" android:max="100" android:progress="70" android:progressTint="@color/warning_orange"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 1: PENDING SCORES CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secScorePendingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp">

                <!-- Course Selector Dropdown Button -->
                <LinearLayout
                    android:id="@+id/btnCourseSelector"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_teacher_dropdown"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_graduation_cap"
                        app:tint="@color/teacher_dark_navy"
                        android:contentDescription="Course" />

                    <TextView
                        android:id="@+id/tvSelectedCourseName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="CS101 - Data Structures"
                        android:textColor="@color/teacher_dark_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/teacher_dark_navy"
                        android:contentDescription="Dropdown" />
                </LinearLayout>

                <!-- Pending Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/teacher_card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/teacher_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_metric_red"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_star_active"
                                app:tint="@color/status_at_risk_text"
                                android:contentDescription="Pending" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Pending Assessments"
                                    android:textColor="@color/status_at_risk_text"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="bottom"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvTotalPendingCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="12"
                                        android:textColor="@color/status_at_risk_text"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvTotalPendingSubtext"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="out of 28 assessments"
                                        android:textColor="@color/status_at_risk_text"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:columnCount="3"
                            android:rowCount="1">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assignments" android:textColor="@color/teacher_secondary_text" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvCountAssignments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="@color/teacher_dark_navy" android:textSize="16sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quizzes" android:textColor="@color/teacher_secondary_text" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvCountQuizzes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="@color/teacher_dark_navy" android:textSize="16sp" android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exams" android:textColor="@color/teacher_secondary_text" android:textSize="11sp"/>
                                <TextView android:id="@+id/tvCountExams" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@color/teacher_dark_navy" android:textSize="16sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Search Input Bar -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/admin_primary_blue"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_search" app:startIconTint="@color/admin_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtSearchPending"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="Search pending assessment title..."
                        android:inputType="text" android:textColor="@color/admin_text_primary" android:textSize="14sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Pending Assessments List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPendingAssessments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 2: ASSIGNMENT SCORES CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secScoreAssignmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assignment Scores Roster" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAssignmentScoresList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 3: QUIZ SCORES CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secScoreQuizzesContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quiz Scores Roster" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvQuizScoresList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 4: EXAM SCORES CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secScoreExamsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Midterm &amp; Final Exam Scores" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExamScoresList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 5: GRADEBOOK CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secScoreGradebookContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student Academic Gradebook Roster" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGradebookRosterList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>