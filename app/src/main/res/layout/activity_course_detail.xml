<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCourseDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/teacher_bg"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="@color/teacher_dark_navy"
            android:contentDescription="@string/back"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/course_detail"
            android:textColor="@color/teacher_dark_navy"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnMoreOptions"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/teacher_dark_navy"
            android:contentDescription="@string/options"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp">

            <!-- Large Course Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/teacher_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/teacher_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Course Identity Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_course_icon_blue">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_book"
                                app:tint="@color/white"
                                android:contentDescription="@string/course" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCourseTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CS101 – Data Structures"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCourseDept"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/computer_science_department"
                                android:textColor="@color/teacher_secondary_text"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvCourseSubtext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Teacher: Mr. Chan"
                                android:textColor="@color/teacher_secondary_text"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="@string/status_active"
                            android:textColor="@color/status_good_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_status_good" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="6dp"
                        android:background="@color/teacher_border" />

                    <!-- Course Information Chips Row (3 Chips) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Chip 1: Student Count / Credits -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_teacher_dropdown"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp">

                            <ImageView
                                android:id="@+id/ivChipStudentIcon"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_group"
                                app:tint="@color/teacher_primary_blue"
                                android:contentDescription="@string/nav_users" />

                            <TextView
                                android:id="@+id/tvChipStudentCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/str_35_students"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Chip 2: Semester -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1.2"
                            android:layout_marginHorizontal="2dp"
                            android:background="@drawable/bg_teacher_dropdown"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/teacher_primary_blue"
                                android:contentDescription="@string/calendar" />

                            <TextView
                                android:id="@+id/tvChipSemester"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/semester_1_2024"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Chip 3: Class Location -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_teacher_dropdown"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_location"
                                app:tint="@color/teacher_primary_blue"
                                android:contentDescription="@string/location" />

                            <TextView
                                android:id="@+id/tvChipRoom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/room_a101"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 5 Course Section Tabs Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabOverview"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="@string/overview"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/teacher_primary_blue"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_chart_bar"
                        app:iconTint="@color/white"
                        app:iconSize="14dp"
                        android:paddingHorizontal="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabStudents"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/nav_students"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/teacher_primary_blue"
                        app:backgroundTint="@color/teacher_surface_light"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_group"
                        app:iconTint="@color/teacher_primary_blue"
                        app:iconSize="14dp"
                        android:paddingHorizontal="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabAssignments"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/assignments"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/teacher_primary_blue"
                        app:backgroundTint="@color/teacher_surface_light"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_assignment"
                        app:iconTint="@color/teacher_primary_blue"
                        app:iconSize="14dp"
                        android:paddingHorizontal="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabQuizzes"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/quizzes"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/teacher_primary_blue"
                        app:backgroundTint="@color/teacher_surface_light"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_pencil_edit"
                        app:iconTint="@color/teacher_primary_blue"
                        app:iconSize="14dp"
                        android:paddingHorizontal="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabExams"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/exams"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/teacher_primary_blue"
                        app:backgroundTint="@color/teacher_surface_light"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_star"
                        app:iconTint="@color/teacher_primary_blue"
                        app:iconSize="14dp"
                        android:paddingHorizontal="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Overview Content Layout -->
            <LinearLayout
                android:id="@+id/layoutOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Course Schedule Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/teacher_card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/teacher_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/teacher_primary_blue"
                                android:contentDescription="@string/calendar" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/course_schedule"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Schedule Table Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp"
                            android:background="@color/teacher_surface_light"
                            android:paddingHorizontal="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/day"
                                android:textColor="@color/teacher_secondary_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:text="@string/time"
                                android:textColor="@color/teacher_secondary_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8"
                                android:text="@string/room"
                                android:textColor="@color/teacher_secondary_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutScheduleRowsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Row 1: Monday -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp"
                                android:paddingHorizontal="8dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/tvSchedDay1"
                                    android:layout_width="0dp"
                                    android:layout_height="22dp"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="@string/monday"
                                    android:textColor="@color/teacher_primary_blue"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_circle_soft_blue" />

                                <TextView
                                    android:id="@+id/tvSchedTime1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:layout_marginStart="8dp"
                                    android:text="08:00 – 09:30"
                                    android:textColor="@color/teacher_dark_navy"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSchedRoom1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.8"
                                    android:text="A101"
                                    android:textColor="@color/teacher_dark_navy"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/teacher_border"/>

                            <!-- Row 2: Wednesday -->
                            <LinearLayout
                                android:id="@+id/rowSchedule2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="8dp"
                                android:paddingHorizontal="8dp"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="22dp"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="@string/wednesday"
                                    android:textColor="@color/teacher_primary_blue"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_circle_soft_blue" />

                                <TextView
                                    android:id="@+id/tvSchedTime2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:layout_marginStart="8dp"
                                    android:text="08:00 – 09:30"
                                    android:textColor="@color/teacher_dark_navy"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSchedRoom2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.8"
                                    android:text="A101"
                                    android:textColor="@color/teacher_dark_navy"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Performance Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/teacher_card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/teacher_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_analytics"
                                app:tint="@color/teacher_primary_blue"
                                android:contentDescription="@string/nav_analytics" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/performance_summary"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Left: Donut Chart -->
                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChartPerformanceSummary"
                                android:layout_width="0dp"
                                android:layout_height="150dp"
                                android:layout_weight="1.2" />

                            <!-- Vertical Divider -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="120dp"
                                android:layout_marginHorizontal="10dp"
                                android:background="@color/teacher_border" />

                            <!-- Right: Performance Indicators -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:paddingStart="4dp">

                                <TextView
                                    android:id="@+id/tvPassRateLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pass_rate"
                                    android:textColor="@color/teacher_secondary_text"
                                    android:textSize="11sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginBottom="8dp">

                                    <TextView
                                        android:id="@+id/tvPassRateVal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="86%"
                                        android:textColor="@color/teacher_dark_navy"
                                        android:textSize="14.5sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvPassRateBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="18dp"
                                        android:layout_marginStart="6dp"
                                        android:gravity="center"
                                        android:paddingHorizontal="6dp"
                                        android:text="@string/status_good"
                                        android:textColor="@color/status_good_text"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/bg_status_good" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvClassAvgLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/class_average"
                                    android:textColor="@color/teacher_secondary_text"
                                    android:textSize="11sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="2dp">

                                    <TextView
                                        android:id="@+id/tvClassAvgVal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="82%"
                                        android:textColor="@color/teacher_dark_navy"
                                        android:textSize="14.5sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvClassAvgBadge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="18dp"
                                        android:layout_marginStart="6dp"
                                        android:gravity="center"
                                        android:paddingHorizontal="6dp"
                                        android:text="@string/status_active"
                                        android:textColor="@color/status_good_text"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:background="@drawable/bg_status_good" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Students in This Course Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStudentsInCourse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/teacher_card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/teacher_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_group"
                                app:tint="@color/teacher_primary_blue"
                                android:contentDescription="@string/nav_users" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/students_in_this_course"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnViewAllStudents"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/view_all"
                                android:textColor="@color/teacher_primary_blue"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Student Avatar Preview Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:gravity="center"
                                android:text="S"
                                android:textColor="@color/teacher_primary_blue"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_circle_soft_blue" />

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:gravity="center"
                                android:text="D"
                                android:textColor="@color/status_at_risk_text"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_status_at_risk" />

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:gravity="center"
                                android:text="R"
                                android:textColor="@color/status_attention_text"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_status_attention" />

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:gravity="center"
                                android:text="V"
                                android:textColor="@color/teacher_primary_blue"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_circle_soft_blue" />

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:gravity="center"
                                android:text="C"
                                android:textColor="@color/status_good_text"
                                android:textSize="12.5sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_status_good" />

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:gravity="center"
                                android:text="+28"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_teacher_dropdown" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalStudentsSubtext"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/total_35_students"
                            android:textColor="@color/teacher_secondary_text"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Learning Insights Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/teacher_surface_light"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/teacher_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/teacher_primary_blue"
                            android:contentDescription="@string/insight" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/learning_insights"
                                android:textColor="@color/teacher_dark_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLearningInsightsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/overall_performance_is_good_keep_up_the_gr"
                                android:textColor="@color/teacher_secondary_text"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Dynamic Sub-Tab Content Layout -->
            <LinearLayout
                android:id="@+id/layoutSubContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSubTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enrolled_students"
                    android:textColor="@color/teacher_dark_navy"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCourseDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvEmptySubContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@string/no_records_found_for_this_course"
                    android:textColor="@color/teacher_secondary_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
