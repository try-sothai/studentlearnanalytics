<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/drawer_surface"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <!-- Close Button (X) with comfortable touch target -->
    <ImageView
        android:id="@+id/btnAdminDrawerClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/close_navigation_drawer"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/drawer_secondary_text" />

    <!-- Avatar with Green Online Dot -->
    <FrameLayout
        android:id="@+id/layoutAvatarContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/drawer_primary_blue"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/imgAdminDrawerAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/administrator_profile_picture"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:tint="@color/drawer_primary_blue" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Green Online Indicator -->
        <View
            android:id="@+id/viewOnlineIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_circle_soft_blue"
            android:backgroundTint="@color/drawer_success_green" />
    </FrameLayout>

    <!-- Profile Text Information -->
    <LinearLayout
        android:id="@+id/layoutAdminProfileText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/btnAdminDrawerClose"
        app:layout_constraintStart_toEndOf="@id/layoutAvatarContainer"
        app:layout_constraintTop_toTopOf="@id/layoutAvatarContainer">

        <TextView
            android:id="@+id/tvAdminDrawerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/admin_slas"
            android:textColor="@color/drawer_dark_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminDrawerRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/system_administrator"
            android:textColor="@color/drawer_secondary_text"
            android:textSize="12sp" />

        <!-- Role + Active Status Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminDrawerRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_drawer_item_active"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/admin_role_badge"
                android:textColor="@color/drawer_primary_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutAdminActiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_admin_status_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:contentDescription="@string/active_star_icon"
                    android:src="@drawable/ic_star_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/status_active"
                    android:textColor="@color/drawer_success_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/drawer_divider"
        app:layout_constraintTop_toBottomOf="@id/layoutAdminProfileText" />

</androidx.constraintlayout.widget.ConstraintLayout>
