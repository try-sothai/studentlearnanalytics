<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/drawer_surface"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Close Button (X) -->
    <ImageView
        android:id="@+id/btnAdminDrawerClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Close Navigation Drawer"
        android:focusable="true"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/drawer_secondary_text" />

    <!-- Avatar with Green Online Dot -->
    <FrameLayout
        android:id="@+id/layoutAvatarContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/drawer_primary_blue"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/imgAdminDrawerAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Administrator Profile Picture"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:tint="@color/drawer_primary_blue" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Green Online Indicator -->
        <View
            android:id="@+id/viewOnlineIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_circle_soft_blue"
            android:backgroundTint="@color/drawer_success_green" />
    </FrameLayout>

    <!-- Profile Text Information -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/layoutAvatarContainer"
        app:layout_constraintEnd_toStartOf="@id/btnAdminDrawerClose"
        app:layout_constraintStart_toEndOf="@id/layoutAvatarContainer"
        app:layout_constraintTop_toTopOf="@id/layoutAvatarContainer">

        <TextView
            android:id="@+id/tvAdminDrawerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mr. Chan"
            android:textColor="@color/drawer_dark_navy"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminDrawerRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="System Administrator"
            android:textColor="@color/drawer_secondary_text"
            android:textSize="12sp" />

        <!-- Green Active Status Badge -->
        <LinearLayout
            android:id="@+id/layoutAdminActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_admin_status_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Active Star Icon"
                android:src="@drawable/ic_star_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Active"
                android:textColor="@color/drawer_success_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/drawer_divider"
        app:layout_constraintTop_toBottomOf="@id/layoutAvatarContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
