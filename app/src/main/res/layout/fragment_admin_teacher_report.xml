<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg"
    android:orientation="vertical">

    <!-- Secondary Navigation Bar for Teacher Reports -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#EAF0FF"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabTeacherOverview"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_tab_active"
                android:gravity="center"
                android:text="@string/overview"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTeacherWorkload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/workload"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTeacherAssignments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/assignments"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabTeacherPerformance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/performance"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Content Frame for Teacher Sub-Tabs -->
    <FrameLayout
        android:id="@+id/layoutTeacherSubContentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SUB-TAB 0: TEACHER OVERVIEW -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secTeacherOverviewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Academic Filters Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spTeacherReportYear"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner" />

                    <Spinner
                        android:id="@+id/spTeacherReportSemester"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_spinner" />
                </LinearLayout>

                <!-- Teacher Statistics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/teacher_statistics_overview"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/admin_border" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:rowCount="2">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/total_faculty" android:textColor="@color/admin_text_secondary" android:textSize="12sp" />
                                <TextView android:id="@+id/tvStatTotalTeachers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="--" android:textColor="@color/admin_primary_blue" android:textSize="18sp" android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/active_staff" android:textColor="@color/admin_text_secondary" android:textSize="12sp" />
                                <TextView android:id="@+id/tvStatActiveTeachers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="--" android:textColor="@color/admin_active_green" android:textSize="18sp" android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/courses_assigned" android:textColor="@color/admin_text_secondary" android:textSize="12sp" />
                                <TextView android:id="@+id/tvStatAssignedCourses" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="--" android:textColor="@color/admin_text_primary" android:textSize="18sp" android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pending_reviews" android:textColor="@color/admin_text_secondary" android:textSize="12sp" />
                                <TextView android:id="@+id/tvStatPendingReviews" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="--" android:textColor="@color/warning_orange" android:textSize="18sp" android:textStyle="bold" />
                            </LinearLayout>
                        </GridLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Teaching Workload Bar Chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teaching Workload Distribution"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chartTeacherWorkloadBar"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Faculty Roster Directory -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Faculty Overview Directory"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/admin_primary_blue"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_search" app:startIconTint="@color/admin_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchTeacherReport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/search_faculty_by_name_department"
                        android:inputType="text" android:textColor="@color/admin_text_primary" android:textSize="14sp" 
                        android:minHeight="44dp"
                        android:paddingVertical="10dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:imeOptions="actionSearch"
                        android:textColorHint="@color/teacher_secondary_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTeacherReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_admin_teacher_report" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 1: TEACHER WORKLOAD -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secTeacherWorkloadContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teaching Workload Metrics" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/admin_border"/>

                        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/total_hours" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,080 Hrs/Wk" android:textColor="@color/admin_primary_blue" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/avg_teacher" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19.2 Hrs/Wk" android:textColor="@color/admin_active_green" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/high_workload" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_8_staff" android:textColor="@color/admin_inactive_red" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/capacity_available" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/str_12_staff" android:textColor="@color/admin_purple_accent" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Workload Distribution Bar Chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/workload_hours_by_department" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold"/>

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chartTeacherWorkloadBarChart"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Workload Directory -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Faculty Teaching Load List" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTeacherWorkloadList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 2: TEACHER ASSIGNMENTS -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secTeacherAssignmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Course &amp; Class Staffing Summary" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/admin_border"/>

                        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/course_assignments" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="36" android:textColor="@color/admin_primary_blue" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/class_assignments" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28" android:textColor="@color/admin_active_green" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Staffed Classes" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="28 / 28 (100%)" android:textColor="@color/admin_purple_accent" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/unassigned" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/admin_active_green" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teacher Assignment Matrix" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTeacherAssignmentsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- SUB-TAB 3: TEACHER PERFORMANCE -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/secTeacherPerformanceContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/faculty_performance_metrics" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold"/>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/admin_border"/>

                        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/avg_score" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="93.8%" android:textColor="@color/admin_primary_blue" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginBottom="12dp" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student Rating" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4.7 / 5.0" android:textColor="@color/admin_active_green" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/course_pass_rate" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="92.4%" android:textColor="@color/admin_purple_accent" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reviews_done" android:textColor="@color/admin_text_secondary" android:textSize="12sp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="53 / 56" android:textColor="@color/warning_orange" android:textSize="18sp" android:textStyle="bold"/>
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Performance Score Bar Chart -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/card_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/admin_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Performance Scores by Faculty" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold"/>

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chartTeacherPerformanceBar"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Performance Roster List -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Faculty Evaluation Scores Roster" android:textColor="@color/admin_text_primary" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTeacherPerformanceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"/>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportTeacherReport"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/export_report"
            android:textAllCaps="false"
            android:textColor="@color/admin_primary_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/admin_primary_blue"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewTeacherReportDetails"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/admin_primary_blue"
            android:text="@string/view_details"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>