<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Date Group Section Header (TODAY, YESTERDAY, THIS WEEK) -->
    <TextView
        android:id="@+id/tvNotifDateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="10dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp"
        android:text="@string/today"
        android:textColor="@color/notif_spec_secondary_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNotif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/card_white"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/divider_color"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/imgNotifIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_soft_blue"
                android:contentDescription="@string/notification_category_icon"
                android:padding="9dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/notif_spec_primary_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNotifTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notification_title"
                        android:textColor="@color/notif_spec_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/viewUnreadDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_dot" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvNotifMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/notification_details_message"
                    android:textColor="@color/notif_spec_secondary_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotifTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="10:30 AM"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/imgNotifChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/chevron_right"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/notif_spec_secondary_text" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

