<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/admin_drawer_view"
    android:layout_width="@dimen/admin_drawer_width"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/bg_admin_drawer"
    android:clickable="true"
    android:elevation="24dp"
    android:fitsSystemWindows="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Fixed Profile Header -->
    <include
        android:id="@+id/headerAdminDrawer"
        layout="@layout/nav_header_admin" />

    <!-- Scrollable Navigation Items -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- Primary Navigation Menu Items -->
            <include
                android:id="@+id/itemDrawerDashboard"
                layout="@layout/item_admin_drawer_menu" />

            <include
                android:id="@+id/itemDrawerUserManagement"
                layout="@layout/item_admin_drawer_menu" />

            <include
                android:id="@+id/itemDrawerCourseManagement"
                layout="@layout/item_admin_drawer_menu" />

            <include
                android:id="@+id/itemDrawerClassManagement"
                layout="@layout/item_admin_drawer_menu" />

            <include
                android:id="@+id/itemDrawerReports"
                layout="@layout/item_admin_drawer_menu" />

            <!-- Expandable Academic & Analytics Section -->
            <LinearLayout
                android:id="@+id/layoutDrawerAnalyticsToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/academic_analytics_tools"
                    android:src="@drawable/ic_analytics"
                    app:tint="@color/drawer_secondary_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/academic_analytics_tools"
                        android:textColor="@color/drawer_dark_navy"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/academic_analytics_tools_desc"
                        android:textColor="@color/drawer_secondary_text"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgDrawerAnalyticsChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/chevron_right"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/drawer_secondary_text" />
            </LinearLayout>

            <!-- Nested Indented Academic & Analytics Sub-Items -->
            <LinearLayout
                android:id="@+id/layoutDrawerAnalyticsChildren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="0dp"
                android:visibility="gone">

                <include
                    android:id="@+id/itemDrawerMlAnalytics"
                    layout="@layout/item_admin_drawer_menu" />

                <include
                    android:id="@+id/itemDrawerFacultyEval"
                    layout="@layout/item_admin_drawer_menu" />

                <include
                    android:id="@+id/itemDrawerIncidentWorkspace"
                    layout="@layout/item_admin_drawer_menu" />

                <include
                    android:id="@+id/itemDrawerSystemStats"
                    layout="@layout/item_admin_drawer_menu" />
            </LinearLayout>

            <include
                android:id="@+id/itemDrawerNotifications"
                layout="@layout/item_admin_drawer_menu" />

            <include
                android:id="@+id/itemDrawerSettings"
                layout="@layout/item_admin_drawer_menu" />

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="10dp"
                android:background="@color/drawer_divider" />

            <!-- "Other" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"
                android:text="@string/other"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/itemDrawerHelp"
                layout="@layout/item_admin_drawer_menu" />

            <include
                android:id="@+id/itemDrawerAbout"
                layout="@layout/item_admin_drawer_menu" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Logout Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/drawer_surface"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/btnAdminDrawerLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_admin_drawer_logout"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/log_out_icon"
                android:src="@drawable/ic_logout_red"
                app:tint="@color/drawer_logout_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/log_out"
                android:textColor="@color/drawer_logout_red"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
