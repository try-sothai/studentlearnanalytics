<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slas_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout
            android:id="@+id/headerTeacherExamDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/layout_teacher_header" />
        </FrameLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshExams"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/pbLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:visibility="gone" />

                    <!-- Exam Information Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardExamInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/card_white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/slas_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <!-- Top row: Type & Status Badge -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvExamTypeBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_stat_card_blue"
                                    android:paddingStart="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="3dp"
                                    android:text="Midterm Examination"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/tvExamStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_stat_card_purple"
                                    android:paddingStart="10dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="10dp"
                                    android:paddingBottom="3dp"
                                    android:text="Scheduled"
                                    android:textColor="@color/slas_primary_purple"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- Exam Title -->
                            <TextView
                                android:id="@+id/tvExamTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Exam Title"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- Course and Class Info -->
                            <TextView
                                android:id="@+id/tvCourseClassInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="PHY101 • Physics • Class A • Fall 2026"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <!-- Schedule & Details Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Date, Time &amp; Duration"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvExamDateDuration"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Nov 25, 2026 • 09:00 – 10:30"
                                        android:textColor="@color/text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.8"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Venue &amp; Total Marks"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tvExamVenueMarks"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Room 301 • 100 Marks"
                                        android:textColor="@color/text_primary"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Description / Instructions -->
                            <TextView
                                android:id="@+id/tvExamDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_stat_card_blue"
                                android:padding="10dp"
                                android:text="Instructions: Paper exam conducted offline in classroom. Grade manually and enter scores."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <!-- Action Buttons inside card -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDeleteExam"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    android:layout_marginEnd="8dp"
                                    android:text="Delete"
                                    android:textAllCaps="false"
                                    android:textColor="@color/slas_danger"
                                    android:textSize="12sp"
                                    app:cornerRadius="8dp"
                                    app:strokeColor="@color/slas_danger" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnEditExam"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    android:layout_marginEnd="8dp"
                                    android:text="Edit Exam"
                                    android:textAllCaps="false"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp"
                                    app:cornerRadius="8dp"
                                    app:strokeColor="@color/primary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPublishResults"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    android:backgroundTint="@color/slas_success"
                                    android:text="Publish Results"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    app:cornerRadius="8dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Statistics Summary Card (All 6 Real Database Statistics) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStatistics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/card_white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/slas_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <!-- Row 1: Students / Graded / Pending -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStatTotalStudents"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/primary"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Total Students"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStatGraded"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/slas_success"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Graded"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStatPending"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textColor="@color/slas_warning"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Pending"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="10dp"
                                android:background="@color/divider_color" />

                            <!-- Row 2: Average / Highest / Lowest -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStatAverage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0.0"
                                        android:textColor="@color/slas_blue"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Average Score"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStatHighest"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0.0"
                                        android:textColor="@color/slas_success"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Highest Score"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvStatLowest"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0.0"
                                        android:textColor="@color/slas_danger"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="Lowest Score"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Mode Switcher: Enter Scores (Batch Roster) vs View Results Table -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_notif_tab_inactive"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <TextView
                            android:id="@+id/tabModeScoreEntry"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_notif_tab_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Enter Scores"
                            android:textColor="@color/white"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tabModeViewResults"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="View Results Table"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- SECTION 1: SCORE ENTRY MODE -->
                    <LinearLayout
                        android:id="@+id/layoutScoreEntrySection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Manual Paper Score Entry"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvRosterCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 students"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Batch Save Bar -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="@color/card_white"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/slas_border"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:id="@+id/tvUnsavedChangesCount"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Type paper scores below, then save"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSaveAllScores"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    android:backgroundTint="@color/primary"
                                    android:enabled="false"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:paddingHorizontal="14dp"
                                    android:text="Save Scores"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Search Bar -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="10dp"
                            app:cardBackgroundColor="@color/card_white"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/slas_border"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="Search"
                                    android:src="@drawable/ic_search"
                                    app:tint="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/edtSearchStudents"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="8dp"
                                    android:background="@null"
                                    android:hint="Search student name or ID..."
                                    android:inputType="text"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/slas_text_hint"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Empty State -->
                        <TextView
                            android:id="@+id/tvEmptyRoster"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:text="No students found in this course offering."
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <!-- Students RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvStudentScores"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- SECTION 2: RESULTS TABLE VIEW -->
                    <LinearLayout
                        android:id="@+id/layoutResultsTableSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Class Examination Results Table"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp"
                            android:text="Scroll horizontally to inspect all score, grade, and publication columns."
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/card_white"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="1dp"
                            app:strokeColor="@color/slas_border"
                            app:strokeWidth="1dp">

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="horizontal">

                                <TableLayout
                                    android:id="@+id/tblExamResults"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    android:stretchColumns="1" />
                            </HorizontalScrollView>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvEmptyResultsTable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:text="No students enrolled in this exam."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
