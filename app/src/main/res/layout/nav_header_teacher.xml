<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/drawer_surface"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Close Button (X) -->
    <ImageView
        android:id="@+id/btnTeacherDrawerClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/close_navigation_drawer"
        android:focusable="true"
        android:padding="4dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/drawer_secondary_text" />

    <!-- Avatar with Green Online Dot -->
    <FrameLayout
        android:id="@+id/layoutTeacherAvatarContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/drawer_primary_blue"
            app:strokeWidth="1.5dp">

            <TextView
                android:id="@+id/tvTeacherDrawerAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_soft_blue"
                android:gravity="center"
                android:text="C"
                android:textColor="@color/drawer_primary_blue"
                android:textSize="18sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/viewTeacherOnlineIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_circle_soft_blue"
            android:backgroundTint="@color/drawer_success_green" />
    </FrameLayout>

    <!-- Profile Text Information -->
    <LinearLayout
        android:id="@+id/layoutTeacherHeaderInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/layoutTeacherAvatarContainer"
        app:layout_constraintEnd_toStartOf="@id/btnTeacherDrawerClose"
        app:layout_constraintStart_toEndOf="@id/layoutTeacherAvatarContainer"
        app:layout_constraintTop_toTopOf="@id/layoutTeacherAvatarContainer">

        <TextView
            android:id="@+id/tvTeacherDrawerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teacher"
            android:textColor="@color/drawer_dark_navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTeacherDrawerRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/teacher_cs_dept"
            android:textColor="@color/drawer_secondary_text"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_admin_status_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="@string/active_star_icon"
                android:src="@drawable/ic_star_active" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/status_active"
                android:textColor="@color/drawer_success_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/drawer_divider"
        app:layout_constraintTop_toBottomOf="@id/layoutTeacherAvatarContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
