<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvCourseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/slas_text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCourseMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/slas_text_hint"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCourseScore"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/slas_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCourseGrade"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/slas_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/viewRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

</LinearLayout>
