<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/headerTeacherDashboard"
        layout="@layout/layout_teacher_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- Summary Cards 2x2 Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1: Total Students & My Courses -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Card 1: Total Students -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTotalStudents"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="11dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_circle_soft_blue"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_profile"
                                    app:tint="@color/primary"
                                    android:contentDescription="@string/nav_students" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="@string/total_students"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTotalStudentsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Enrolled across classes"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 2: My Courses -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMyCourses"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="11dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_stat_card_green"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_book"
                                    app:tint="@color/success_green"
                                    android:contentDescription="@string/nav_courses" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="@string/my_courses"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvMyCoursesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="--"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Active teaching load"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Row 2: At-Risk Students & Pending Scores -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Card 3: At-Risk Students -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAtRisk"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="11dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_notification_risk"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_prediction"
                                    app:tint="@color/white"
                                    android:contentDescription="@string/risk" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="@string/at_risk_students"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAtRiskCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="--"
                                android:textColor="@color/danger_red"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Needs academic support"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Card 4: Pending Scores -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPendingScores"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/divider_color"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="11dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/bg_stat_card_blue"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_assignment"
                                    app:tint="@color/secondary_blue"
                                    android:contentDescription="@string/status_pending" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:text="@string/pending_scores"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11.5sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvPendingScoresCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="--"
                                android:textColor="@color/primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Awaiting grade entry"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Student Learning Engagement Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Title & Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/learning_engagement_overview"
                                android:textColor="@color/text_primary"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEngagementSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/attendance_assignment_homework_quiz"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <!-- Refresh Action Button -->
                        <ImageView
                            android:id="@+id/btnRefreshChart"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/refresh_analytics"
                            android:padding="5dp"
                            android:src="@drawable/ic_refresh"
                            app:tint="@color/text_secondary" />

                    </LinearLayout>

                    <!-- Dynamic Horizontal Filters Scroll -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Year Selector -->
                            <Spinner
                                android:id="@+id/spinnerAcademicYear"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="8dp"
                                android:paddingEnd="24dp" />

                            <!-- Semester Selector -->
                            <Spinner
                                android:id="@+id/spinnerSemester"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="8dp"
                                android:paddingEnd="24dp" />

                            <!-- Course Selector -->
                            <Spinner
                                android:id="@+id/spinnerCourse"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="8dp"
                                android:paddingEnd="24dp" />

                            <!-- Class Selector -->
                            <Spinner
                                android:id="@+id/spinnerClass"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="8dp"
                                android:paddingEnd="24dp" />

                            <!-- Program / Major Selector -->
                            <Spinner
                                android:id="@+id/spinnerProgram"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="8dp"
                                android:paddingEnd="24dp" />

                            <!-- Study Year Selector -->
                            <Spinner
                                android:id="@+id/spinnerStudyYear"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="5dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="8dp"
                                android:paddingEnd="24dp" />

                            <!-- Generation Selector -->
                            <Spinner
                                android:id="@+id/spinnerGeneration"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_spinner"
                                android:paddingStart="8dp"
                                android:paddingEnd="24dp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Chart Legend Indicators -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Completed Legend -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle_soft_blue"
                            android:backgroundTint="#10B981" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="12dp"
                            android:text="@string/status_completed"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp" />

                        <!-- Late Legend -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle_soft_blue"
                            android:backgroundTint="#F59E0B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="12dp"
                            android:text="@string/status_late"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp" />

                        <!-- Missed Legend -->
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle_soft_blue"
                            android:backgroundTint="#EF4444" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/missed"
                            android:textColor="@color/text_secondary"
                            android:textSize="10.5sp" />

                    </LinearLayout>

                    <!-- Chart Container with Loading, Empty & Error States -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="195dp"
                        android:layout_marginTop="6dp">

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/barChartEngagement"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ProgressBar
                            android:id="@+id/pbChartLoading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layoutChartEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/no_activity_data"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/no_learning_events_recorded"
                                android:textColor="@color/text_secondary"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutChartError"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvChartErrorMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/failed_load_engagement_analytics"
                                android:textColor="@color/danger_red"
                                android:textSize="12.5sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRetryChart"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/retry"
                                android:textColor="@color/primary"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Activities Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/recent_activities_cc0a4a"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Activity 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_soft_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_assignment"
                            app:tint="@color/primary"
                            android:contentDescription="@string/activity" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Added quiz scores - CS101"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="2 hours ago"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="8dp" />

                    <!-- Activity 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stat_card_green"
                            android:padding="6dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/success_green"
                            android:contentDescription="@string/activity" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Updated attendance - CS102"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="4 hours ago"
                                android:textColor="@color/text_secondary"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="8dp" />

                    <!-- Activity 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_stat_card_purple"
                            android:padding="6dp"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/primary"
                            android:contentDescription="@string/activity" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/new_student_enrolled_cs101"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="1 day ago"
                                android:textColor="@color/text_secondary"
