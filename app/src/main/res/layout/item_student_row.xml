<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/teacher_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/teacher_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Avatar -->
        <TextView
            android:id="@+id/tvAvatarChar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/teacher_primary_blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_circle_soft_blue" />

        <!-- Student Name, ID, GPA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sophea"
                android:textColor="@color/teacher_dark_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudentId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="STU023001"
                android:textColor="@color/teacher_secondary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStudentGpa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/gpa_3_25"
                android:textColor="@color/teacher_secondary_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStudentSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPredictedScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Right Column: Status Badge, Program, Year Level -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/status_good"
                android:textColor="@color/status_good_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_good" />

            <TextView
                android:id="@+id/tvStudentProgram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/computer_science"
                android:textColor="@color/teacher_secondary_text"
                android:textSize="11sp"
                android:gravity="end" />

            <TextView
                android:id="@+id/tvStudentYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/str_3rd_year"
                android:textColor="@color/teacher_secondary_text"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>

        <!-- Chevron Right -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/teacher_secondary_text"
            android:contentDescription="@string/details" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
