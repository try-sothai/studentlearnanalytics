<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <!-- Header Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_social_button"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/slas_indigo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toStartOf="@id/semesterSelector"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="@id/btnBack">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommendations"
                    android:textColor="@color/slas_text_dark_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personalized suggestions for your learning"
                    android:textColor="@color/slas_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/semesterSelector"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:strokeColor="@color/slas_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/tvSemesterText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semester 1, 2024 ▾"
                        android:textColor="@color/slas_indigo"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scroll Content (Starts cleanly at TOP = 0, No Header Clipping) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollViewRec"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="blocksDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Hero Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/slas_border"
                app:strokeWidth="1.5dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/imgGoalIcon"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:src="@drawable/ic_prediction"
                        android:background="@drawable/bg_stat_card_purple"
                        android:padding="12dp"
                        android:contentDescription="Goal Icon"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/slas_primary_purple" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toStartOf="@id/imgCharacter"
                        app:layout_constraintStart_toEndOf="@id/imgGoalIcon"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Let's Achieve Your Goals!"
                            android:textColor="@color/slas_text_dark_navy"
                            android:textStyle="bold"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Better Learning • A Brighter Future"
                            android:textColor="@color/slas_primary_purple"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Follow these recommendations to improve your performance."
                            android:textColor="@color/slas_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgCharacter"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_profile"
                        android:contentDescription="Illustration"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Your Current Performance Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📊 Your Current Performance"
                    android:textColor="@color/slas_text_dark_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/btnViewPerformanceDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Details →"
                    android:textColor="@color/slas_primary_purple"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- KPI 1: Attendance -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="@color/slas_border"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_home" android:contentDescription="Attendance Icon" app:tint="@color/slas_success" android:background="@drawable/bg_stat_card_green" android:padding="6dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Attendance" android:textSize="11sp" android:textColor="@color/slas_text_secondary" android:layout_marginTop="6dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="88%" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good" android:textSize="10sp" android:textStyle="bold" android:textColor="#087A52" android:background="#E1F8EF" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- KPI 2: Assignments -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="@color/slas_border"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_assignment" android:contentDescription="Assignment Icon" app:tint="@color/slas_primary_purple" android:background="@drawable/bg_stat_card_purple" android:padding="6dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assignments" android:textSize="11sp" android:textColor="@color/slas_text_secondary" android:layout_marginTop="6dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80%" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good" android:textSize="10sp" android:textStyle="bold" android:textColor="#087A52" android:background="#E1F8EF" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- KPI 3: Quizzes -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="@color/slas_border"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_analytics" android:contentDescription="Quiz Icon" app:tint="@color/slas_warning" android:background="@drawable/bg_stat_card_orange" android:padding="6dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quizzes" android:textSize="11sp" android:textColor="@color/slas_text_secondary" android:layout_marginTop="6dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="78%" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Improve" android:textSize="10sp" android:textStyle="bold" android:textColor="#8A5A00" android:background="#FFF1C9" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Personalized Recommendations List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="💡 Personalized Recommendations"
                android:textColor="@color/slas_text_dark_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <!-- Rec 1: Improve Quiz Performance -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/slas_border"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_card_orange"
                            android:padding="9dp"
                            android:src="@drawable/ic_analytics"
                            android:contentDescription="Quiz Rec"
                            app:tint="@color/slas_warning" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Improve Quiz Performance" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High Priority" android:textSize="10sp" android:textStyle="bold" android:textColor="#C62848" android:background="#FFE6EA" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                            </LinearLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your quiz performance has decreased by 2%. Review weak topics." android:textColor="@color/slas_text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnViewQuizDetails"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:text="View Quiz Details"
                                    android:textSize="11sp"
                                    android:textColor="@color/slas_primary_purple"
                                    app:strokeColor="@color/slas_primary_purple"
                                    android:paddingHorizontal="14dp"
                                    android:textAllCaps="false"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rec 2: Maintain Good Attendance -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/slas_border"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_card_green"
                            android:padding="9dp"
                            android:src="@drawable/ic_home"
                            android:contentDescription="Attendance Rec"
                            app:tint="@color/slas_success" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Maintain Good Attendance" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keep Going" android:textSize="10sp" android:textStyle="bold" android:textColor="#087A52" android:background="#E1F8EF" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                            </LinearLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keep attending classes regularly to maintain your good performance." android:textColor="@color/slas_text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnViewAttendance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:text="View Attendance"
                                    android:textSize="11sp"
                                    android:textColor="@color/slas_primary_purple"
                                    app:strokeColor="@color/slas_primary_purple"
                                    android:paddingHorizontal="14dp"
                                    android:textAllCaps="false"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rec 3: Focus on Weak Topics -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/slas_border"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_card_purple"
                            android:padding="9dp"
                            android:src="@drawable/ic_assignment"
                            android:contentDescription="Weak Topics Rec"
                            app:tint="@color/slas_primary_purple" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Focus on Weak Topics" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="High Priority" android:textSize="10sp" android:textStyle="bold" android:textColor="#C62848" android:background="#FFE6EA" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                            </LinearLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Spend more time reviewing topics in Data Structures where your performance is lower." android:textColor="@color/slas_text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnViewWeakTopics"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:text="View Analytics →"
                                    android:textSize="11sp"
                                    android:textColor="@color/slas_primary_purple"
                                    app:strokeColor="@color/slas_primary_purple"
                                    android:paddingHorizontal="14dp"
                                    android:textAllCaps="false"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rec 4: Set Study Schedule -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/slas_border"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_card_blue"
                            android:padding="9dp"
                            android:src="@drawable/ic_calendar"
                            android:contentDescription="Schedule Rec"
                            app:tint="@color/slas_indigo" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Set Study Schedule" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recommended" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/slas_indigo" android:background="#EEE9FF" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                            </LinearLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create a consistent study routine to improve your learning progress." android:textColor="@color/slas_text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnViewSchedule"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:text="View Schedule →"
                                    android:textSize="11sp"
                                    android:textColor="@color/slas_primary_purple"
                                    app:strokeColor="@color/slas_primary_purple"
                                    android:paddingHorizontal="14dp"
                                    android:textAllCaps="false"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rec 5: Use Learning Resources -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/slas_border"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_card_blue"
                            android:padding="9dp"
                            android:src="@drawable/ic_book"
                            android:contentDescription="Resources Rec"
                            app:tint="@color/slas_blue" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Use Learning Resources" android:textStyle="bold" android:textColor="@color/slas_text_dark_navy" android:textSize="14sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recommended" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/slas_indigo" android:background="#EEE9FF" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                            </LinearLayout>
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Review learning resources and practice materials to strengthen your understanding." android:textColor="@color/slas_text_secondary" android:textSize="12sp" android:layout_marginTop="4dp" />

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnViewResources"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:text="View Resources →"
                                    android:textSize="11sp"
                                    android:textColor="@color/slas_primary_purple"
                                    app:strokeColor="@color/slas_primary_purple"
                                    android:paddingHorizontal="14dp"
                                    android:textAllCaps="false"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Bottom Progress Banner (SLAS Gradient Card) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_performance_card"
                    android:padding="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_prediction" android:contentDescription="Trophy" app:tint="@color/white" android:layout_marginEnd="14dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Small Steps Lead to Big Success!" android:textStyle="bold" android:textColor="@color/white" android:textSize="15sp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Be consistent and keep improving." android:textSize="12sp" android:textColor="#E0E0E0" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrackProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Track My Progress →"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/slas_primary_purple"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="10dp"
                        android:textAllCaps="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
