<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/prediction_bg"
    android:fitsSystemWindows="true"
    tools:context=".student.PredictionFragment">

    <!-- Top Header Bar -->
    <include
        android:id="@+id/headerStudentPrediction"
        layout="@layout/layout_student_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <!-- Card 1: Predicted Score -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/prediction_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/prediction_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/predicted_final_exam_score"
                        android:textColor="@color/prediction_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/scoreBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPredictionScoreValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="82.8"
                            android:textColor="@color/prediction_purple"
                            android:textSize="40sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="6dp"
                            android:text="/ 100"
                            android:textColor="@color/prediction_text_secondary"
                            android:textSize="14.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPredictionSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/based_on_current_gpa_attendance_and_quiz_p"
                        android:textColor="@color/prediction_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Risk Level -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRiskLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/prediction_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/prediction_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/academic_risk_level"
                                android:textColor="@color/prediction_text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPredictionRiskValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/low_risk_e60aca"
                                android:textColor="@color/prediction_warning"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRiskDetails"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/risk_analysis"
                            android:textColor="@color/prediction_purple"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/prediction_purple" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Key Factors -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/prediction_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/prediction_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/key_factors_affecting_prediction"
                        android:textColor="@color/prediction_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Factor 1: Attendance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/class_attendance_rate"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp" />

                        <ProgressBar
                            android:id="@+id/pbPredAttendance"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="90dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="12dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/prediction_border"
                            android:progressTint="@color/prediction_success" />

                        <TextView
                            android:id="@+id/tvPredictionAttendanceValue"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="--%"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Factor 2: Assignments -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/assignment_performance"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp" />

                        <ProgressBar
                            android:id="@+id/pbPredAssignment"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="90dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="12dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/prediction_border"
                            android:progressTint="@color/prediction_purple" />

                        <TextView
                            android:id="@+id/tvPredictionAssignmentValue"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="--%"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Factor 3: Quizzes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quiz_performance"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp" />

                        <ProgressBar
                            android:id="@+id/pbPredQuiz"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="90dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="12dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/prediction_border"
                            android:progressTint="@color/prediction_warning" />

                        <TextView
                            android:id="@+id/tvPredictionQuizValue"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="--%"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Factor 4: Previous Exams -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/previous_exam_score"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp" />

                        <ProgressBar
                            android:id="@+id/pbPredExam"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="90dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="12dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/prediction_border"
                            android:progressTint="@color/prediction_purple" />

                        <TextView
                            android:id="@+id/tvPredictionExamValue"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="--%"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Factor 5: Current GPA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/current_cumulative_gpa"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tvPredictionGpaValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="3.25 / 4.00"
                            android:textColor="@color/prediction_purple"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Trend Chart -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/prediction_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/prediction_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prediction_score_trend"
                        android:textColor="@color/prediction_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChartTrend"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Recommendations CTA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/prediction_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/prediction_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/improve_your_score"
                            android:textColor="@color/prediction_text_main"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/view_personalized_ai_recommendations_to_bo"
                            android:textColor="@color/prediction_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewRecommendations"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:backgroundTint="@color/prediction_purple"
                        android:text="@string/view_recs"
                        android:textSize="12sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>