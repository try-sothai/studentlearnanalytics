<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/teacher_drawer_view"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/bg_admin_drawer"
    android:clickable="true"
    android:elevation="16dp"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Compact Profile Header -->
    <include
        android:id="@+id/headerTeacherDrawer"
        layout="@layout/nav_header_teacher" />

    <!-- Scrollable Navigation Items -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- 1. Dashboard -->
            <include
                android:id="@+id/itemTeacherDrawerDashboard"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 2. Students -->
            <include
                android:id="@+id/itemTeacherDrawerStudents"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 3. Courses -->
            <include
                android:id="@+id/itemTeacherDrawerCourses"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 4. Assessments -->
            <include
                android:id="@+id/itemTeacherDrawerAssessments"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 5. Prediction & Risk -->
            <include
                android:id="@+id/itemTeacherDrawerPrediction"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 6. Manage Scores -->
            <include
                android:id="@+id/itemTeacherDrawerScores"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 7. Attendance -->
            <include
                android:id="@+id/itemTeacherDrawerAttendance"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 8. Recommendations -->
            <include
                android:id="@+id/itemTeacherDrawerRecommendation"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 9. Reports -->
            <include
                android:id="@+id/itemTeacherDrawerReports"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 10. Prediction Evaluation -->
            <include
                android:id="@+id/itemTeacherDrawerEvaluation"
                layout="@layout/item_admin_drawer_menu" />

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="10dp"
                android:background="@color/drawer_divider" />

            <!-- "Account & Settings" Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"
                android:text="@string/account"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 11. Notifications -->
            <include
                android:id="@+id/itemTeacherDrawerNotifications"
                layout="@layout/item_admin_drawer_menu" />

            <!-- 12. Profile -->
            <include
                android:id="@+id/itemTeacherDrawerProfile"
                layout="@layout/item_admin_drawer_menu" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Logout Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/btnTeacherDrawerLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_admin_drawer_logout"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/log_out_icon"
                android:src="@drawable/ic_logout_red"
                app:tint="@color/drawer_logout_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/log_out"
                android:textColor="@color/drawer_logout_red"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>