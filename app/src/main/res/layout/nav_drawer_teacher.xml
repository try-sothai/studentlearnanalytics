<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/teacher_drawer_view"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/bg_admin_drawer"
    android:clickable="true"
    android:elevation="16dp"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Compact Profile Header -->
    <include
        android:id="@+id/headerTeacherDrawer"
        layout="@layout/nav_header_teacher" />

    <!-- Scrollable Navigation Items -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/itemTeacherDrawerDashboard"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerStudents"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerCourses"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerAssessments"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerPrediction"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerScores"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerAttendance"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerRecommendation"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerReports"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerEvaluation"
                layout="@layout/item_teacher_drawer_menu" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginVertical="6dp"
                android:background="@color/drawer_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/account"
                android:textColor="@color/drawer_secondary_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/itemTeacherDrawerNotifications"
                layout="@layout/item_teacher_drawer_menu" />

            <include
                android:id="@+id/itemTeacherDrawerProfile"
                layout="@layout/item_teacher_drawer_menu" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Logout Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/btnTeacherDrawerLogout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_admin_drawer_logout"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/log_out_icon"
                android:src="@drawable/ic_logout_red"
                app:tint="@color/drawer_logout_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/log_out"
                android:textColor="@color/drawer_logout_red"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
