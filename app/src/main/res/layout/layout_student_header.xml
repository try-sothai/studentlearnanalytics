<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_white"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Menu Icon (☰) on the left -->
    <ImageView
        android:id="@+id/btnStudentMenuHeader"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Menu"
        android:focusable="true"
        android:padding="4dp"
        android:src="@drawable/ic_menu"
        app:tint="@color/admin_text_primary" />

    <!-- Center Titles -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Portal"
            android:textColor="@color/admin_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Student Learning Analytics System"
            android:textColor="@color/admin_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Right Side: Notification Icon with Badge + Profile Avatar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/layoutStudentNotifBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgStudentNotifBell"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_soft_blue"
                android:contentDescription="Notifications"
                android:padding="8dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/admin_primary_blue" />

            <TextView
                android:id="@+id/tvStudentNotifBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_nav_badge_red"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/layoutStudentAvatarBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvStudentAvatarText"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_soft_blue"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/admin_primary_blue"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Search"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            app:tint="@color/admin_text_primary" />

    </LinearLayout>
</LinearLayout>