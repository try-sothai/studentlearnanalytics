<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_white"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Menu Icon (☰) on the left -->
    <ImageView
        android:id="@+id/btnStudentMenuHeader"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/menu"
        android:focusable="true"
        android:padding="5dp"
        android:src="@drawable/ic_menu"
        app:tint="@color/admin_text_primary" />

    <!-- Center Titles -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/student_portal"
            android:textColor="@color/admin_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/student_learning_analytics_system"
            android:textColor="@color/admin_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right Side: Notification Icon with Badge + Profile Avatar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/layoutStudentNotifBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/imgStudentNotifBell"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_soft_blue"
                android:contentDescription="@string/nav_notifications"
                android:padding="7dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/admin_primary_blue" />

            <TextView
                android:id="@+id/tvStudentNotifBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_nav_badge_red"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/layoutStudentAvatarBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvStudentAvatarText"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_soft_blue"
                android:gravity="center"
                android:text="S"
                android:textColor="@color/admin_primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/search"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            app:tint="@color/admin_text_primary" />

    </LinearLayout>
</LinearLayout>
