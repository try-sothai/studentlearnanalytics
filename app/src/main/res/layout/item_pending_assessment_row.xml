<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/teacher_card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/teacher_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Column 1: Left Section (Type Icon, Title, Points, Due Date & Badge) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/typeIconContainer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_metric_red"
                android:layout_gravity="top">

                <ImageView
                    android:id="@+id/imgTypeIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_assignment"
                    app:tint="@color/status_at_risk_text"
                    android:contentDescription="@string/type" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAssessmentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assignment 2: Linked Lists"
                    android:textColor="@color/teacher_dark_navy"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTypePoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/assignment_100_points"
                    android:textColor="@color/teacher_secondary_text"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/teacher_secondary_text"
                        android:contentDescription="@string/due_date" />

                    <TextView
                        android:id="@+id/tvDueDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Oct 10, 2024"
                        android:textColor="@color/teacher_secondary_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDueStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/status_overdue"
                        android:textColor="@color/status_at_risk_text"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_status_at_risk" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Divider 1 -->
        <View
            android:layout_width="1dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/teacher_border" />

        <!-- Column 2: Middle Section (Completion Ratio, Progress Bar, Remaining) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvProgressRatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18 / 35"
                android:textColor="@color/teacher_dark_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBarScoreEntry"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="51"
                android:progressDrawable="@drawable/bg_circular_progress" />

            <TextView
                android:id="@+id/tvRemainingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17 remaining"
                android:textColor="@color/teacher_secondary_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Vertical Divider 2 -->
        <View
            android:layout_width="1dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/teacher_border" />

        <!-- Column 3: Right Section ("Enter Scores" Button & Chevron) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnterScores"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/enter_scores"
                android:textAllCaps="false"
                android:textSize="11sp"
                android:textColor="@color/white"
                app:backgroundTint="@color/teacher_primary_blue"
                app:cornerRadius="18dp"
                android:paddingHorizontal="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/teacher_secondary_text"
                android:contentDescription="@string/details" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
